#!/usr/bin/env python3
"""canvas — the CANVAS distribution CLI.

Renders the host-neutral core/ into a specific AI-agent host's format
(opencode, claude-code, cursor, copilot, codex, ...). This is the seam that
keeps core/ (the "what") separate from adapters/ (the "how per host").

Usage:
    canvas export --host <host> [--target <dir>] [--global]
    canvas list
    canvas version

Each host has an adapter under adapters/<host>/ that knows how to render
core/ + core/manifest.json into that host's expected on-disk layout.
"""
from __future__ import annotations

import argparse
import json
import shutil
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent  # repo root
CACHE_ROOT = Path.home() / ".canvas"  # hidden installer cache (not a project clone)


def load_manifest() -> dict:
    with open(ROOT / "core" / "manifest.json") as f:
        return json.load(f)


def version() -> str:
    v = (ROOT / "VERSION").read_text().strip()
    return v or "0.1.0"


def available_hosts() -> list[str]:
    adapter_dir = ROOT / "adapters"
    if not adapter_dir.exists():
        return []
    return [d.name for d in adapter_dir.iterdir() if d.is_dir() and (d / "render.py").exists()]


def load_renderer(host: str, root: Path | None = None):
    """Dynamically import adapters/<host>/render.py and return its render() fn."""
    import importlib.util

    base = root or ROOT
    path = base / "adapters" / host / "render.py"
    if not path.exists():
        print(f"error: no adapter for host '{host}' (expected {path})", file=sys.stderr)
        sys.exit(1)
    spec = importlib.util.spec_from_file_location(f"canvas_adapter_{host}", path)
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


def fetch_remote(url: str) -> Path:
    """Fetch the CANVAS repo into the hidden ~/.canvas cache (no consumer clone).

    Returns the checkout path to render from. A shallow clone keeps it small;
    the cache persists so references.canvas `path:` can point at it and repeat
    installs are instant. `--from` is the remote install surface used by the
    bootstrap (curl) installer — the user never clones CANVAS into their project.
    """
    cache = CACHE_ROOT / "src"
    cache.mkdir(parents=True, exist_ok=True)
    needle = url.rstrip("/").split("/")[-1] or "canvas"
    dest = cache / needle
    is_git_url = url.startswith("git@") or url.startswith("git://") or url.endswith(".git") or "github.com:" in url
    if is_git_url:
        if not (dest / ".git").exists():
            subprocess.run(
                ["git", "clone", "--depth", "1", url, str(dest)],
                check=True, capture_output=True,
            )
        else:
            subprocess.run(["git", "-C", str(dest), "pull", "--ff-only"], check=True, capture_output=True)
    else:
        shutil.rmtree(dest, ignore_errors=True)
        dest.parent.mkdir(parents=True, exist_ok=True)
        shutil.copytree(url, dest, dirs_exist_ok=True)  # local path source (dev/testing)
    return dest


def cmd_export(args) -> int:
    manifest = load_manifest()
    manifest["_canvas_version"] = version()
    if getattr(args, "repo", None):
        manifest["_canvas_repo"] = args.repo
    renderer = load_renderer(args.host)

    # Remote install: render from a fetched checkout instead of this local repo.
    root = ROOT
    if getattr(args, "from_", None):
        root = fetch_remote(args.from_)
        print(f"  fetched CANVAS from {args.from_} -> {root}", file=sys.stderr)
        try:
            manifest = json.loads((root / "core" / "manifest.json").read_text())
        except Exception:
            pass
        manifest["_canvas_version"] = (root / "VERSION").read_text().strip() or "0.1.0"
        if getattr(args, "repo", None):
            manifest["_canvas_repo"] = args.repo
        elif isinstance(args.from_, str) and (args.from_.startswith("git@") or args.from_.startswith("git://") or args.from_.endswith(".git") or "github.com:" in args.from_):
            manifest["_canvas_repo"] = args.from_  # remote URL implies repository: auto-fetch
        renderer = load_renderer(args.host, root=root)

    # Plugin hosts build a self-contained bundle into the repo's distribution/
    # dir by default (and keep the marketplace manifest in sync).
    plugin_defaults = {
        "claude-plugin": root / "distribution" / "claude-plugin" / "canvas",
    }
    if args.host == "opencode" and args.target is None and not args.global_:
        # Bare project install: land .opencode/ + opencode.json in the current
        # folder (the folder where the curl bootstrap runs) — nothing global.
        default_target = Path.cwd()
    else:
        default_target = plugin_defaults.get(args.host, root)
    target = Path(args.target or default_target).expanduser().resolve()
    if not args.global_:
        target.mkdir(parents=True, exist_ok=True)

    try:
        written = renderer.render(root=root, manifest=manifest, target=target, global_install=args.global_)
    except NotImplementedError as e:
        print(f"error: {e}", file=sys.stderr)
        return 1

    if args.host == "claude-plugin":
        written += _write_claude_marketplace(manifest)

    for rel in written:
        print(f"  wrote {rel}")
    shown = "global (host user config)" if args.global_ else target
    print(f"\nCANVAS v{version()} exported to host '{args.host}' at {shown}")
    print(f"  installed: {len(written)} artifacts")
    if args.global_:
        print("  Restart the host tool to load the new skills/agents.")
    return 0


def _write_claude_marketplace(manifest: dict) -> list[str]:
    """Write .claude-plugin/marketplace.json at the repo root listing the local
    plugin bundle, so `claude plugin marketplace add <CANVAS repo>` works.
    Relative sources require a git-based marketplace (the CANVAS repo)."""
    v = manifest.get("_canvas_version") or "0.1.0"
    mkt = {
        "name": "canvas-marketplace",
        "owner": {"name": "Dito Cesartista"},
        "description": "CANVAS — agentic native-Android coding system.",
        "version": v,
        "plugins": [
            {
                "name": "canvas",
                "source": "./distribution/claude-plugin/canvas",
                "description": "Agentic native-Android coding: scaffold/feature/audit/perf skills + workers + reference corpus.",
                "version": v,
                "author": {"name": "Dito Cesartista", "email": "m.cesartista@gmail.com"},
            }
        ],
    }
    mkt_dir = ROOT / ".claude-plugin"
    mkt_dir.mkdir(parents=True, exist_ok=True)
    (mkt_dir / "marketplace.json").write_text(json.dumps(mkt, indent=2) + "\n")
    return [".claude-plugin/marketplace.json"]


def cmd_list(args) -> int:
    print(f"CANVAS v{version()}")
    print("hosts available:")
    for h in available_hosts():
        print(f"  - {h}")
    print("core exportables:")
    for skill in load_manifest()["skills"]:
        print(f"  skill  {skill['id']}")
    for agent in load_manifest()["agents"]:
        print(f"  agent  {agent['id']}")
    return 0


def main(argv=None) -> int:
    p = argparse.ArgumentParser(prog="canvas", description=__doc__)
    sub = p.add_subparsers(dest="cmd", required=True)

    ex = sub.add_parser("export", help="render core/ into a host's format")
    ex.add_argument("--host", required=True, choices=available_hosts() or None,
                    help="target host (see adapters/)")
    ex.add_argument("--target", default=None,
                    help="output directory (default: the current folder for opencode project installs)")
    ex.add_argument("--project", dest="target", default=None,
                    help="alias for --target: output directory (project-local install target)")
    ex.add_argument("--global", dest="global_", action="store_true",
                    help="install into the host's GLOBAL/user config instead of a project dir")
    ex.add_argument("--from", dest="from_", default=None,
                    help="CANVAS git URL (or local path) to fetch and render from — the remote install / curl surface; no consumer clone")
    ex.add_argument("--repo", default=None,
                    help="CANVAS git URL for the opencode references.canvas 'repository' field (auto-fetch, no clone); defaults to $CANVAS_REPO")
    ex.set_defaults(fn=cmd_export)

    ls = sub.add_parser("list", help="list hosts + core exportables")
    ls.set_defaults(fn=cmd_list)

    args = p.parse_args(argv)
    return args.fn(args)


if __name__ == "__main__":
    raise SystemExit(main())
