#!/usr/bin/env python3
"""canvas — the CANVAS distribution CLI.

Renders the host-neutral core/ into a specific AI-agent host's format
(opencode, claude-code, cursor, copilot, codex, ...). This is the seam that
keeps core/ (the "what") separate from adapters/ (the "how per host").

Usage:
    canvas export --host <host> [--target <dir>] [--global]
    canvas list
    canvas version

Each host has an adapter under adapters/<host>/ that knows how to render
core/ + core/manifest.json into that host's expected on-disk layout.
"""
from __future__ import annotations

import argparse
import json
import shutil
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent  # repo root
CACHE_ROOT = Path.home() / ".canvas"  # hidden installer cache (not a project clone)


def load_manifest() -> dict:
    with open(ROOT / "core" / "manifest.json") as f:
        return json.load(f)


def version() -> str:
    v = (ROOT / "VERSION").read_text().strip()
    return v or "0.1.0"


def available_hosts() -> list[str]:
    adapter_dir = ROOT / "adapters"
    if not adapter_dir.exists():
        return []
    return [d.name for d in adapter_dir.iterdir() if d.is_dir() and (d / "render.py").exists()]


def load_renderer(host: str, root: Path | None = None):
    """Dynamically import adapters/<host>/render.py and return its render() fn."""
    import importlib.util

    base = root or ROOT
    path = base / "adapters" / host / "render.py"
    if not path.exists():
        print(f"error: no adapter for host '{host}' (expected {path})", file=sys.stderr)
        sys.exit(1)
    spec = importlib.util.spec_from_file_location(f"canvas_adapter_{host}", path)
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


def fetch_remote(source: str) -> Path:
    """Resolve the CANVAS checkout to render from, given a `--from` source.

    The bootstrap (curl) installer clones CANVAS into the hidden ~/.canvas cache
    and hands that existing checkout dir here — so if `source` is already a
    CANVAS directory we use it in place (no re-fetch, no self-collision). For a
    git URL we shallow-clone into the cache. The consumer project is never
    cloned into. Returns the checkout path to render from.
    """
    url = str(source).rstrip("/")
    is_git_url = url.startswith("git@") or url.startswith("git://") or url.endswith(".git") or "github.com:" in url

    if not is_git_url and Path(url).is_dir():
        p = Path(url).expanduser().resolve()
        if (p / "scripts" / "canvas").exists():
            return p  # already a CANVAS checkout — use in place
        # bare local dir source (dev/testing): copy into cache
        cache = CACHE_ROOT / "src"
        cache.mkdir(parents=True, exist_ok=True)
        dest = cache / (p.name or "canvas")
        shutil.rmtree(dest, ignore_errors=True)
        shutil.copytree(p, dest)
        return dest

    # git URL (or ambiguous string): clone-or-refresh into the cache
    cache = CACHE_ROOT / "src"
    cache.mkdir(parents=True, exist_ok=True)
    needle = url.split("/")[-1].replace(".git", "") or "canvas"
    dest = cache / needle
    if not (dest / ".git").exists():
        subprocess.run(["git", "clone", "--depth", "1", url, str(dest)], check=True, capture_output=True)
    else:
        subprocess.run(["git", "-C", str(dest), "fetch", "--depth", "1", "origin"], check=True, capture_output=True)
        subprocess.run(["git", "-C", str(dest), "reset", "--hard", "FETCH_HEAD"], check=True, capture_output=True)
    return dest


def _collect_siblings(args) -> dict:
    """Parse --sibling NAME=URL / --sibling-path NAME=DIR into {name: {url?, path?}}."""
    sib: dict = {}
    for pair in (getattr(args, "sibling", None) or []):
        name, _, url = pair.partition("=")
        if name and url:
            sib.setdefault(name, {})["url"] = url
    for pair in (getattr(args, "sibling_path", None) or []):
        name, _, path = pair.partition("=")
        if name and path:
            sib.setdefault(name, {})["path"] = path
    return sib


def _record_install(args, manifest: dict, root: Path, target: Path) -> None:
    """Record a successful export in ~/.canvas/installed.json so `update` can
    replay the same scope/hosts/repo sources later. Only recorded when a repo
    URL is known (the curl-installer path); ad-hoc local exports stay out."""
    repo = getattr(args, "repo", None)
    if not repo:
        from_ = getattr(args, "from_", None)
        if from_ and (str(from_).startswith("git@") or str(from_).endswith(".git") or "github.com:" in str(from_)):
            repo = from_
    if not repo:
        return

    state = _load_state()
    state.setdefault("installs", [])
    rec = {
        "scope": "global" if args.global_ else "project",
        "target": "global" if args.global_ else str(target),
        "host": args.host,
        "repo": repo,
        "siblings": {k: v.get("url") or v.get("path") for k, v in manifest.get("_siblings", {}).items() if v.get("url") or v.get("path")},
        "commit": _git_head(root),
        "version": manifest.get("_canvas_version", ""),
    }
    for i, existing in enumerate(state["installs"]):
        if existing.get("scope") == rec["scope"] and existing.get("target") == rec["target"] and existing.get("host") == rec["host"]:
            state["installs"][i] = rec
            break
    else:
        state["installs"].append(rec)
    _save_state(state)


def _git_head(root: Path) -> str:
    try:
        out = subprocess.run(["git", "-C", str(root), "rev-parse", "HEAD"], check=True, capture_output=True, text=True)
        return out.stdout.strip()
    except Exception:
        return ""


def _load_state() -> dict:
    sf = CACHE_ROOT / "installed.json"
    if not sf.exists():
        return {}
    try:
        return json.loads(sf.read_text())
    except Exception:
        return {}


def _save_state(state: dict) -> None:
    CACHE_ROOT.mkdir(parents=True, exist_ok=True)
    (CACHE_ROOT / "installed.json").write_text(json.dumps(state, indent=2) + "\n")


def cmd_export(args) -> int:
    return _run_export(args)


def _run_export(args) -> int:
    manifest = load_manifest()
    manifest["_canvas_version"] = version()
    if getattr(args, "repo", None):
        manifest["_canvas_repo"] = args.repo
    manifest["_siblings"] = _collect_siblings(args)
    renderer = load_renderer(args.host)

    # Remote install: render from a fetched checkout instead of this local repo.
    root = ROOT
    if getattr(args, "from_", None):
        root = fetch_remote(args.from_)
        print(f"  fetched CANVAS from {args.from_} -> {root}", file=sys.stderr)
        try:
            manifest = json.loads((root / "core" / "manifest.json").read_text())
        except Exception:
            pass
        manifest["_canvas_version"] = (root / "VERSION").read_text().strip() or "0.1.0"
        if getattr(args, "repo", None):
            manifest["_canvas_repo"] = args.repo
        elif isinstance(args.from_, str) and (args.from_.startswith("git@") or args.from_.startswith("git://") or args.from_.endswith(".git") or "github.com:" in args.from_):
            manifest["_canvas_repo"] = args.from_  # remote URL implies repository: auto-fetch
        manifest["_siblings"] = _collect_siblings(args)
        renderer = load_renderer(args.host, root=root)

    if args.target is None and not args.global_:
        # Bare project install: land the host's project layout in the current
        # folder (where the curl bootstrap runs) — nothing global.
        default_target = Path.cwd()
    else:
        default_target = root
    target = Path(args.target or default_target).expanduser().resolve()
    if not args.global_:
        target.mkdir(parents=True, exist_ok=True)

    try:
        written = renderer.render(root=root, manifest=manifest, target=target, global_install=args.global_)
    except NotImplementedError as e:
        print(f"error: {e}", file=sys.stderr)
        return 1

    for rel in written:
        print(f"  wrote {rel}")
    shown = "global (host user config)" if args.global_ else target
    print(f"\nCANVAS v{version()} exported to host '{args.host}' at {shown}")
    print(f"  installed: {len(written)} artifacts")
    _record_install(args, manifest, root, target)
    if args.global_:
        print("  Restart the host tool to load the new skills/agents.")
    return 0


def cmd_update(args) -> int:
    """Replay recorded installs: refresh the fetched sources, re-export any that
    are behind their recorded git commit. Backs the `curl | sh -- --update`."""
    state = _load_state()
    installs = state.get("installs", [])
    scope = "global" if args.global_ else "project"
    target_dir = None if args.global_ else Path(args.target or Path.cwd()).expanduser().resolve()

    matches = []
    for rec in installs:
        if rec.get("scope") != scope:
            continue
        if scope == "global":
            matches.append(rec)
            continue
        if Path(rec.get("target", "")).expanduser().resolve() == target_dir:
            matches.append(rec)

    if not matches:
        where = "global install" if args.global_ else f"project install at {target_dir}"
        print(f"canvas: no recorded {where} — run the curl installer first.", file=sys.stderr)
        return 1

    updated = 0
    wanted_hosts = set(args.host or [])
    for rec in matches:
        host = rec.get("host")
        if wanted_hosts and host not in wanted_hosts:
            continue
        repo = rec.get("repo")
        if not repo:
            continue
        cache = fetch_remote(repo)
        head = _git_head(cache)
        if head and head == rec.get("commit"):
            print(f"canvas: {host} @ {scope} already up to date ({rec.get('version')})")
            continue

        siblings = rec.get("siblings") or {}
        sibling_args, sibling_path_args = [], []
        for name, loc in siblings.items():
            if loc and (loc.startswith("http") or loc.startswith("git@") or loc.endswith(".git")):
                sibling_args.append(f"{name}={loc}")
                sibling_path_args.append(f"{name}={fetch_remote(loc)}")
            elif loc:
                sibling_path_args.append(f"{name}={loc}")

        ns = argparse.Namespace(
            host=host,
            target=None if args.global_ else str(target_dir),
            global_=args.global_,
            from_=repo,
            repo=repo,
            sibling=sibling_args or None,
            sibling_path=sibling_path_args or None,
        )
        print(f"canvas: updating {host} @ {scope} ({rec.get('version')} -> new)")
        rc = _run_export(ns)
        if rc != 0:
            return rc
        updated += 1

    print(f"\ncanvas: update complete — {updated} install(s) refreshed")
    return 0


def cmd_list(args) -> int:
    print(f"CANVAS v{version()}")
    print("hosts available:")
    for h in available_hosts():
        print(f"  - {h}")
    print("core exportables:")
    for skill in load_manifest()["skills"]:
        print(f"  skill  {skill['id']}")
    for agent in load_manifest()["agents"]:
        print(f"  agent  {agent['id']}")
    return 0


def main(argv=None) -> int:
    p = argparse.ArgumentParser(prog="canvas", description=__doc__)
    sub = p.add_subparsers(dest="cmd", required=True)

    ex = sub.add_parser("export", help="render core/ into a host's format")
    ex.add_argument("--host", required=True, choices=available_hosts() or None,
                    help="target host (see adapters/)")
    ex.add_argument("--target", default=None,
                    help="output directory (default: the current folder for opencode project installs)")
    ex.add_argument("--project", dest="target", default=None,
                    help="alias for --target: output directory (project-local install target)")
    ex.add_argument("--global", dest="global_", action="store_true",
                    help="install into the host's GLOBAL/user config instead of a project dir")
    ex.add_argument("--from", dest="from_", default=None,
                    help="CANVAS git URL (or local path) to fetch and render from — the remote install / curl surface; no consumer clone")
    ex.add_argument("--repo", default=None,
                    help="CANVAS git URL for the opencode references.canvas 'repository' field (auto-fetch, no clone); defaults to $CANVAS_REPO")
    ex.add_argument("--sibling", action="append", default=None, metavar="NAME=URL",
                    help="sibling repo git URL to include (repeatable; e.g. palette=https://github.com/dcesartista/PALETTE.git)")
    ex.add_argument("--sibling-path", action="append", default=None, metavar="NAME=DIR",
                    help="local checkout dir for a sibling repo (repeatable; used by hosts without auto-fetch, e.g. claude-code)")
    ex.set_defaults(fn=cmd_export)

    ls = sub.add_parser("list", help="list hosts + core exportables")
    ls.set_defaults(fn=cmd_list)

    up = sub.add_parser("update", help="refresh recorded installs (curl | sh --update)")
    up.add_argument("--target", default=None, dest="target",
                    help="project dir whose recorded install to update (default: current folder)")
    up.add_argument("--project", dest="target", default=None,
                    help="alias for --target")
    up.add_argument("--global", dest="global_", action="store_true",
                    help="update the GLOBAL install instead of a project")
    up.add_argument("--host", default=None, action="append",
                    help="only update this host (repeatable)")
    up.set_defaults(fn=cmd_update)

    args = p.parse_args(argv)
    return args.fn(args)


if __name__ == "__main__":
    raise SystemExit(main())
